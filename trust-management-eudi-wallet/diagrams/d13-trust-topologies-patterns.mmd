      s_hub --- s_p3[Party]
    end
    subgraph topo_tree["Hierarchical · classic PKI tree<br/>Root delegates to intermediates; path validation walks the chain.<br/>Fits organisations and scoped delegation."]
      direction TB
      t_root((Root CA))
      t_root --- t_mid[Intermediate CA]
      t_mid --- t_ee[End entity]
    end
    subgraph topo_mesh["Mesh / peer-to-peer<br/>Many roots or peers; trust is local or pairwise.<br/>Flexible — scaling needs shared directories or strict out-of-band discipline."]
